# GitHub personal access token, read-only (public_repo / no extra scopes needed).
# Required for the Code Search API and to raise the public-events rate limit.
GITHUB_TOKEN=

# SQLite database path (redacted findings only; never raw secrets).
LEAKWATCH_DB=leakwatch.db

# Poll intervals (seconds).
CODE_SEARCH_INTERVAL=900
EVENTS_INTERVAL=60

# Comma-separated provider allowlist. Empty = all known providers.
PROVIDER_ALLOWLIST=

# DANGER: verifying a key means *using* someone else's credential.
# Leave false. Only a documented stub exists; there is no live verification in v1.
ENABLE_VERIFICATION=false
